# LocalAI Angel Unified v1.0.0 defaults
# Copy to .env only if you do not already have a working .env.
# This relative folder is portable and stores Angel history/knowledge beside the app.
ANGEL_USER_DATA=./Angel_Platform_Data
ANGEL_TIMEZONE=America/Indiana/Indianapolis
ANGEL_LLM_PROVIDER=localai
ANGEL_OLLAMA_FALLBACK=true
ANGEL_DEFAULT_MODEL=llama3.2:3b
