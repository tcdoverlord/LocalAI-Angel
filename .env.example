# LocalAI-Angel Unified settings
# The model provider defaults to LocalAI inside this Compose stack.
ANGEL_LLM_PROVIDER=localai
ANGEL_LOCALAI_BASE_URL=http://api:8080
ANGEL_OLLAMA_BASE_URL=http://ollama:11434
ANGEL_OLLAMA_FALLBACK=true
ANGEL_DEFAULT_MODEL=qwen2.5:3b
ANGEL_TIMEZONE=America/Indiana/Indianapolis
LOCALAI_API_KEY=
